<script>
function filterHelp(q) {
  const term = q.trim().toLowerCase();
  const sections = document.querySelectorAll('.help-section');
  sections.forEach(s => {
    const tags = (s.dataset.tags || '').toLowerCase();
    const text = s.innerText.toLowerCase();
    s.classList.toggle('hidden', term && !tags.includes(term) && !text.includes(term));
  });
  document.getElementById('toc').classList.toggle('hidden', !!term);
}
</script>
