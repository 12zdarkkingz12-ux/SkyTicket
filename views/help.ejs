<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>التعليمات — SkyTicket</title>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <style>
    .help-page { max-width: 860px; margin: 0 auto; padding: 32px 20px 80px; }
    .help-back  { display:inline-flex;align-items:center;gap:8px;color:var(--text-muted);text-decoration:none;font-size:14px;margin-bottom:24px;transition:color .15s }
    .help-back:hover { color:var(--text) }
    .help-hero  { text-align:center;padding:40px 20px 32px;margin-bottom:8px }
    .help-hero-icon { font-size:56px;margin-bottom:12px }
    .help-hero h1 { font-size:28px;font-weight:700;margin:0 0 8px }
    .help-hero p  { color:var(--text-muted);font-size:15px;margin:0 }
    .help-search-wrap { max-width:480px;margin:0 auto 32px;position:relative }
    .help-search-wrap input {
      width:100%;padding:12px 16px 12px 40px;border-radius:10px;
      border:1px solid var(--border);background:var(--bg2);
      color:var(--text);font-size:14px;box-sizing:border-box;
    }
    .help-search-wrap::before { content:'🔍';position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:16px;pointer-events:none }
    .help-toc { display:flex;flex-wrap:wrap;gap:10px;margin-bottom:32px;padding:16px;background:var(--bg2);border-radius:12px;border:1px solid var(--border) }
    .help-toc a { font-size:13px;color:var(--accent);text-decoration:none;padding:4px 10px;background:var(--accent-bg);border-radius:6px;white-space:nowrap }
    .help-toc a:hover { opacity:.8 }
    .help-section { scroll-margin-top:24px }
    .section-badge { display:inline-block;font-size:11px;padding:2px 8px;border-radius:99px;font-weight:600;margin-bottom:10px }
    .badge-admin   { background:#3b4bdb22;color:#7b8cde }
    .badge-warn    { background:#f5a62322;color:#f5a623 }
    .badge-tip     { background:#2ecc7122;color:#2ecc71 }
    .help-cmd { display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid var(--border2) }
    .help-cmd:last-child { border-bottom:none }
    .help-cmd code { font-size:13px;white-space:nowrap;flex-shrink:0 }
    .help-cmd-desc { font-size:13px;color:var(--text-muted);margin-top:2px }
    .err-card { padding:14px;background:var(--bg3);border-radius:8px;margin-bottom:10px }
    .err-card:last-child { margin-bottom:0 }
    .err-title { font-weight:600;font-size:14px;margin-bottom:6px }
    .err-body  { font-size:13px;color:var(--text-muted);line-height:1.6 }
    .err-danger { border-right:3px solid var(--danger) }
    .err-warn   { border-right:3px solid var(--warning) }
    .err-dark   { border-right:3px solid var(--accent) }
    .dark-card  { background:linear-gradient(135deg,#1e2a4a,#2a1f3d);border:1px solid var(--accent);border-radius:16px;padding:28px;display:flex;align-items:center;gap:24px;flex-wrap:wrap }
    .dark-avatar{ width:80px;height:80px;border-radius:50%;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:40px;flex-shrink:0 }
    .dark-btn   { display:inline-flex;align-items:center;gap:8px;padding:11px 22px;background:var(--accent);color:#fff;border-radius:9px;text-decoration:none;font-weight:700;font-size:14px;margin-top:14px;transition:opacity .2s }
    .dark-btn:hover { opacity:.85 }
    .step-row   { display:flex;gap:14px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border2) }
    .step-row:last-child { border-bottom:none }
    .step-num   { width:30px;height:30px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0 }
    .lifecycle-row { display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--border2) }
    .lifecycle-row:last-child { border-bottom:none }
    .lifecycle-icon { width:38px;height:38px;border-radius:50%;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0 }
    .hidden { display:none !important }
  </style>
</head>
<body>
<div class="help-page">

  <!-- Back -->
  <a href="/guild/<%= guild.id %>" class="help-back">← العودة للوحة التحكم</a>

  <!-- Hero -->
  <div class="help-hero">
    <div class="help-hero-icon">📖</div>
    <h1>تعليمات SkyTicket</h1>
    <p>دليل شامل لفريق الإدارة — كيف تستخدم البوت وماذا تفعل لو واجهتك مشكلة</p>
  </div>

  <!-- Search -->
  <div class="help-search-wrap">
    <input type="text" id="help-search" placeholder="ابحث عن أمر أو مشكلة..." oninput="filterHelp(this.value)">
  </div>

  <!-- Table of Contents -->
  <div class="help-toc" id="toc">
    <a href="#setup">🚀 الإعداد الأول</a>
    <a href="#dashboard">🖥️ لوحة التحكم</a>
    <a href="#panels">🗂️ اللوحات</a>
    <a href="#tickets">🎫 إدارة التذاكر</a>
    <a href="#staff">👥 فريق الدعم</a>
    <a href="#points">⭐ النقاط والرتب</a>
    <a href="#keywords">💬 الردود التلقائية</a>
    <a href="#problems">🔧 مشاكل شائعة</a>
    <a href="#contact">🛠️ تواصل مع عمك دارك</a>
  </div>

  <!-- ══════════════════════════════════════════
       1. الإعداد الأول
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="setup" data-tags="إعداد أول مرة بدء تشغيل">
    <div class="card-header"><div class="card-title">🚀 الإعداد الأول</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:4px">

      <div class="step-row">
        <div class="step-num">1</div>
        <div>
          <div style="font-weight:600;margin-bottom:3px">افتح لوحة التحكم</div>
          <div style="font-size:13px;color:var(--text-muted)">سجّل دخولك من الرابط الذي أعطاك إياه عمك دارك واختر سيرفرك</div>
        </div>
      </div>

      <div class="step-row">
        <div class="step-num">2</div>
        <div>
          <div style="font-weight:600;margin-bottom:3px">اضبط الإعدادات الأساسية</div>
          <div style="font-size:13px;color:var(--text-muted)">من تبويب <strong>الإعدادات</strong>: حدد قناة السجلات، رتبة فريق الدعم، ورتبة نظام النقاط (إذا تبغى التلقائي)</div>
        </div>
      </div>

      <div class="step-row">
        <div class="step-num">3</div>
        <div>
          <div style="font-weight:600;margin-bottom:3px">أنشئ لوحة التذاكر</div>
          <div style="font-size:13px;color:var(--text-muted)">من تبويب <strong>اللوحات</strong> اضغط "＋ إنشاء لوحة"، حدد التصنيفات والاسم والزر — أو استخدم <code>/panel create</code></div>
        </div>
      </div>

      <div class="step-row">
        <div class="step-num">4</div>
        <div>
          <div style="font-weight:600;margin-bottom:3px">أرسل اللوحة في القناة</div>
          <div style="font-size:13px;color:var(--text-muted)">بعد إنشاء اللوحة اضغط <strong>إرسال</strong> من لوحة التحكم أو استخدم: <code>/panel send panel_id:1</code></div>
        </div>
      </div>

      <div class="step-row">
        <div class="step-num">5</div>
        <div>
          <div style="font-weight:600;margin-bottom:3px">أضف فريق الدعم</div>
          <div style="font-size:13px;color:var(--text-muted)">إما من تبويب <strong>فريق الدعم</strong> في لوحة التحكم، أو بـ <code>/staff add @عضو</code>، أو حدد رتبة في الإعدادات ليتم إضافتهم تلقائياً</div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════
       2. لوحة التحكم
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="dashboard" data-tags="لوحة تحكم داشبورد تبويبات">
    <div class="card-header"><div class="card-title">🖥️ لوحة التحكم — نظرة عامة</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:10px;font-size:14px">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px">
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>📊 الرئيسية</strong><br><span style="font-size:12px;color:var(--text-muted)">إحصائيات عامة وأفضل فريق الدعم هذا الأسبوع</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>🗂️ اللوحات</strong><br><span style="font-size:12px;color:var(--text-muted)">إنشاء وتعديل وإرسال لوحات التذاكر</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>🎫 التذاكر</strong><br><span style="font-size:12px;color:var(--text-muted)">عرض كل التذاكر المفتوحة والمغلقة مع الفلاتر</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>👥 فريق الدعم</strong><br><span style="font-size:12px;color:var(--text-muted)">إدارة الأعضاء ومشاهدة النقاط وتعيين الرتب</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>💬 الردود التلقائية</strong><br><span style="font-size:12px;color:var(--text-muted)">إضافة ردود تلقائية على كلمات مفتاحية داخل التذاكر</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>🚫 الحظر</strong><br><span style="font-size:12px;color:var(--text-muted)">عرض المستخدمين المحظورين ورفع الحظر</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>⚙️ الإعدادات</strong><br><span style="font-size:12px;color:var(--text-muted)">كل إعدادات البوت في مكان واحد</span></div>
        <div style="padding:12px;background:var(--bg3);border-radius:8px"><strong>📋 السجلات</strong><br><span style="font-size:12px;color:var(--text-muted)">سجل كامل بكل العمليات في السيرفر</span></div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       3. اللوحات
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="panels" data-tags="لوحة panel إنشاء تعديل إرسال تصنيف فئة">
    <div class="card-header"><div class="card-title">🗂️ إدارة اللوحات</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:14px;font-size:14px">

      <div>
        <div class="section-badge badge-admin">إجراءات الإدارة</div>
        <div style="display:flex;flex-direction:column;gap:6px">
          <div class="help-cmd"><code>/panel create name:اسم</code><div><div class="help-cmd-desc">إنشاء لوحة جديدة عبر Discord مباشرة</div></div></div>
          <div class="help-cmd"><code>/panel send panel_id:رقم</code><div><div class="help-cmd-desc">أرسل اللوحة في القناة الحالية — الرقم تجده من لوحة التحكم أو <code>/panel list</code></div></div></div>
          <div class="help-cmd"><code>/panel list</code><div><div class="help-cmd-desc">عرض كل اللوحات مع أرقامها</div></div></div>
          <div class="help-cmd"><code>/panel delete panel_id:رقم</code><div><div class="help-cmd-desc">حذف لوحة نهائياً</div></div></div>
        </div>
      </div>

      <div style="padding:12px;background:var(--bg3);border-radius:8px;font-size:13px">
        <strong>⚙️ إعدادات اللوحة (زر ✏️ من لوحة التحكم)</strong><br>
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px;color:var(--text-muted)">
          <div>• <strong>تصنيف التذاكر المفتوحة</strong> — القنوات تُنشأ هنا عند فتح تذكرة</div>
          <div>• <strong>تصنيف التذاكر المغلقة</strong> — القنوات تنتقل هنا بعد الإغلاق</div>
          <div>• <strong>رتبة الذكر</strong> — يتم ذكر هذه الرتبة عند فتح كل تذكرة</div>
          <div>• <strong>طلب سبب الإغلاق</strong> — يُلزم فريق الدعم بكتابة سبب عند الإغلاق</div>
          <div>• <strong>إرسال نسخة نصية</strong> — يُرسل للمستخدم نص المحادثة بعد الإغلاق</div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════
       4. إدارة التذاكر
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="tickets" data-tags="تذكرة فتح إغلاق استلام أولوية نقل">
    <div class="card-header"><div class="card-title">🎫 إدارة التذاكر</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:14px">

      <!-- Lifecycle -->
      <div>
        <div class="section-badge badge-tip">دورة حياة التذكرة</div>
        <div>
          <div class="lifecycle-row">
            <div class="lifecycle-icon">🟢</div>
            <div><div style="font-weight:600;margin-bottom:3px">فتح</div><div style="font-size:13px;color:var(--text-muted)">المستخدم يضغط الزر ← تُنشأ قناة خاصة ← يُذكر فريق الدعم (إذا مفعّل)</div></div>
          </div>
          <div class="lifecycle-row">
            <div class="lifecycle-icon">✋</div>
            <div><div style="font-weight:600;margin-bottom:3px">استلام</div><div style="font-size:13px;color:var(--text-muted)">عضو الدعم يضغط "استلام" ← تُسجَّل نقاطه ووقت استجابته</div></div>
          </div>
          <div class="lifecycle-row">
            <div class="lifecycle-icon">📌</div>
            <div><div style="font-weight:600;margin-bottom:3px">إدارة</div><div style="font-size:13px;color:var(--text-muted)">تغيير الأولوية • نقل لعضو آخر • إضافة مستخدمين • ملاحظات داخلية</div></div>
          </div>
          <div class="lifecycle-row">
            <div class="lifecycle-icon">🔒</div>
            <div><div style="font-weight:600;margin-bottom:3px">إغلاق</div><div style="font-size:13px;color:var(--text-muted)">تأكيد الإغلاق (+ سبب إذا مطلوب) ← القناة تنتقل للتصنيف المغلق ← المستخدم يقيّم الخدمة</div></div>
          </div>
          <div class="lifecycle-row">
            <div class="lifecycle-icon">⏱️</div>
            <div><div style="font-weight:600;margin-bottom:3px">إغلاق تلقائي</div><div style="font-size:13px;color:var(--text-muted)">بعد انتهاء المدة المحددة بدون نشاط ← تحذير ← إغلاق. تُعدَّل المدد من الإعدادات</div></div>
          </div>
        </div>
      </div>

      <!-- Commands -->
      <div>
        <div class="section-badge badge-admin">الأوامر داخل التذكرة</div>
        <div style="display:flex;flex-direction:column">
          <div class="help-cmd"><code>/ticket add @عضو</code><div><div class="help-cmd-desc">إضافة مستخدم للتذكرة الحالية</div></div></div>
          <div class="help-cmd"><code>/ticket remove @عضو</code><div><div class="help-cmd-desc">إزالة مستخدم من التذكرة</div></div></div>
          <div class="help-cmd"><code>/ticket priority مستوى</code><div><div class="help-cmd-desc">تعيين أولوية: منخفضة / عادية / عالية / عاجلة</div></div></div>
          <div class="help-cmd"><code>/ticket transfer @عضو</code><div><div class="help-cmd-desc">نقل التذكرة لعضو دعم آخر</div></div></div>
          <div class="help-cmd"><code>/ticket note نص</code><div><div class="help-cmd-desc">إضافة ملاحظة داخلية مرئية لفريق الدعم فقط</div></div></div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════
       5. فريق الدعم
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="staff" data-tags="فريق دعم staff إضافة إزالة متاح">
    <div class="card-header"><div class="card-title">👥 إدارة فريق الدعم</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:14px">

      <div style="display:flex;flex-direction:column">
        <div class="help-cmd"><code>/staff add @عضو</code><div><div class="help-cmd-desc">إضافة عضو لفريق الدعم يدوياً</div></div></div>
        <div class="help-cmd"><code>/staff remove @عضو</code><div><div class="help-cmd-desc">إزالة عضو من فريق الدعم</div></div></div>
        <div class="help-cmd"><code>/staff list</code><div><div class="help-cmd-desc">عرض قائمة الفريق مع نقاطهم وحالتهم</div></div></div>
        <div class="help-cmd"><code>/staff toggle</code><div><div class="help-cmd-desc">يستخدمها عضو الدعم ليغيّر حالته بين متاح وغير متاح</div></div></div>
      </div>

      <div style="padding:12px;background:var(--accent-bg);border:1px solid var(--accent);border-radius:8px;font-size:13px">
        <strong>🔄 الإضافة التلقائية بالرتبة:</strong><br>
        من <strong>الإعدادات ← رتبة نظام النقاط</strong>، اختر رتبة Discord واحدة وكل من يملكها يُضاف للوحة النقاط تلقائياً.
        عند نزع الرتبة يختفي تلقائياً. بعد الاختيار اضغط <strong>مزامنة الأعضاء الحاليين</strong> لإضافة من عندهم الرتبة مسبقاً.
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════
       6. النقاط والرتب
  ═══════════════════════════════════════════ -->
  <div class="card help-section" id="points" data-tags="نقاط رتبة مبتدئ نشيط محترف خبير أسطورة ستريك setrank">
    <div class="card-header"><div class="card-title">⭐ نظام النقاط والرتب</div></div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:16px">

      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
          <tr style="border-bottom:1px solid var(--border)">
            <th style="text-align:right;padding:8px;color:var(--text-muted)">الرتبة</th>
            <th style="text-align:right;padding:8px;color:var(--text-muted)">النقاط</th>
            <th style="text-align:right;padding:8px;color:var(--text-muted)">كيف تصل إليها</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid var(--border)"><td style="padding:8px">🌱 مبتدئ</td><td style="padding:8px;color:var(--text-muted)">0+</td><td style="padding:8px;font-size:12px;color:var(--text-muted)">تلقائي عند الانضمام لفريق الدعم</td></tr>
          <tr style="border-bottom:1px solid var(--border)"><td style="padding:8px">⚡ نشيط</td><td style="padding:8px;color:var(--accent)">100</td><td style="padding:8px;font-size:12px;color:var(--text-muted)">~10 تذكرة أو ردود سريعة</td></tr>
          <tr style="border-bottom:1px solid var(--border)"><td style="padding:8px">🌟 محترف</td><td style="padding:8px;color:var(--accent)">300</td><td style="padding:8px;font-size:12px;color:var(--text-muted)">~30 تذكرة أو ستريك مستمر</td></tr>
          <tr style="border-bottom:1px solid var(--border)"><td style="padding:8px">💎 خبير</td><td style="padding:8px;color:var(--accent)">700</td><td style="padding:8px;font-size:12px;color:var(--text-muted)">~70 تذكرة مع ردود سريعة</td></tr>
          <tr><td style="padding:8px">🏆 أسطورة</td><td style="padding:8px;color:var(--warning)">1500</td><td style="padding:8px;font-size:12px;color:var(--text-muted)">عضو دعم استثنائي</td></tr>
        </tbody>
      </table>

      <div style="padding:12px;background:var(--bg3);border-radius:8px;font-size:13px;display:flex;flex-direction:column;gap:6px">
        <strong>كيف تُكسب النقاط؟</strong>
        <div>🎫 إغلاق تذكرة = <strong>+10 نقاط</strong> + مكافأة ستريك</div>
