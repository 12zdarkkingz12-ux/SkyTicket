<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تسجيل الدخول — SkyTicket</title>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="login-page">
    <div class="login-card">
      <div class="login-brand">
        <div class="login-logo-wrap">
          <img src="/logo.png?v=<%= assetVersion %>" alt="SkyTicket logo" class="login-logo-img" onerror="this.style.display='none';this.parentElement.classList.add('fallback')">
        </div>
        <div class="login-title">SkyTicket</div>
        <div class="login-kicker">Pro Dashboard</div>
      </div>

      <p class="login-subtitle">سجّل دخولك بحساب Discord للوصول إلى لوحة التحكم</p>

      <% if (error) { %>
        <div class="alert alert-error" style="margin-top:14px"><%= error %></div>
      <% } %>

      <a href="/auth/discord" class="login-btn">
        <svg width="20" height="20" viewBox="0 0 71 55" fill="none" aria-hidden="true">
          <path d="M60.1 4.9A58.5 58.5 0 0 0 45.5.9a40.5 40.5 0 0 0-1.8 3.7 54.1 54.1 0 0 0-16.4 0A40.9 40.9 0 0 0 25.5.9 58.4 58.4 0 0 0 10.9 5C1.6 18.9-1 32.5.3 45.9A59 59 0 0 0 18.3 55a44.8 44.8 0 0 0 3.9-6.3 38.4 38.4 0 0 1-6.1-2.9l1.5-1.1c11.8 5.5 24.6 5.5 36.3 0l1.5 1.1a38.5 38.5 0 0 1-6.1 2.9 44.8 44.8 0 0 0 3.9 6.3 58.8 58.8 0 0 0 17.9-9.1C72.7 30.4 68.6 17 60.1 4.9ZM23.7 37.8c-3.5 0-6.4-3.2-6.4-7.1s2.8-7.1 6.4-7.1 6.5 3.2 6.4 7.1c0 3.9-2.8 7.1-6.4 7.1Zm23.6 0c-3.5 0-6.4-3.2-6.4-7.1s2.8-7.1 6.4-7.1 6.5 3.2 6.4 7.1c0 3.9-2.8 7.1-6.4 7.1Z" fill="#fff"/>
        </svg>
        تسجيل الدخول بـ Discord
      </a>

      <div class="login-footer">
        <p>🔒 يُطلب صلاحية <strong>Administrator</strong> في السيرفر للوصول</p>
        <p style="margin-top:6px">SkyTicket • by Dark</p>
      </div>

    </div>
  </div>
</body>
</html>
