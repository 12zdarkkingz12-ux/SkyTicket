// ─── TRANSCRIPT ───────────────────────────────────────────────
async function viewTranscript(ticketId) {
  openModal('modal-transcript');
  const frame   = document.getElementById('transcript-frame');
  const loading = document.getElementById('transcript-loading');
  const empty   = document.getElementById('transcript-empty');
  frame.style.display   = 'none';
  loading.style.display = 'block';
  empty.style.display   = 'none';

  try {
    const data = await api('GET', `/api/transcript/${ticketId}`);
    loading.style.display = 'none';
    if (data.content) {
      frame.style.display = 'block';
      frame.srcdoc = data.content;
    } else {
      empty.style.display = 'block';
    }
  } catch (err) {
    loading.style.display = 'none';
    empty.style.display   = 'block';
    toast(err.message, 'error');
  }
}

