<!-- ══════════════════════════════════════════════════════════
     JAVASCRIPT
═══════════════════════════════════════════════════════════ -->
<script>
const sidebarToggle = document.getElementById('sidebar-toggle');
const sidebarBackdrop = document.getElementById('sidebar-backdrop');
const sidebar = document.getElementById('guild-sidebar');

function setSidebarOpen(open) {
  document.body.classList.toggle('sidebar-open', open);
  if (sidebarToggle) sidebarToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
}

if (sidebarToggle) {
  sidebarToggle.addEventListener('click', () => {
    setSidebarOpen(!document.body.classList.contains('sidebar-open'));
  });
}

if (sidebarBackdrop) {
  sidebarBackdrop.addEventListener('click', () => setSidebarOpen(false));
}

window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') setSidebarOpen(false);
});

window.addEventListener('resize', () => {
  if (window.innerWidth > 900) setSidebarOpen(false);
});

document.querySelectorAll('.sidebar a, .sidebar .nav-item[data-tab]').forEach(el => {
  el.addEventListener('click', () => {
    if (window.innerWidth <= 900) setSidebarOpen(false);
  });
});

// ─── Tab Navigation ──────────────────────────────────────────
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const tab = document.getElementById('tab-' + name);
  if (tab) tab.classList.add('active');
  const nav = document.querySelector(`[data-tab="${name}"]`);
  if (nav) nav.classList.add('active');
}

document.querySelectorAll('.nav-item[data-tab]').forEach(item => {
  item.addEventListener('click', () => showTab(item.dataset.tab));
});

// ─── Modals ───────────────────────────────────────────────────
function openModal(id) {
  document.getElementById(id).classList.add('open');
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}
// Close on overlay click
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', e => {
    if (e.target === overlay) overlay.classList.remove('open');
  });
});

// ─── Toast Notifications ─────────────────────────────────────
function toast(message, type = 'info') {
  const icons = { success: '✅', error: '❌', info: 'ℹ️' };
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span class="toast-icon">${icons[type]}</span><span>${message}</span>`;
  document.getElementById('toast-container').appendChild(el);
  setTimeout(() => {
    el.classList.add('toast-exit');
    setTimeout(() => el.remove(), 300);
  }, 3500);
}

// ─── API Helper ───────────────────────────────────────────────
async function api(method, url, data) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  if (data) opts.body = JSON.stringify(data);
  const res = await fetch(url, opts);
  const json = await res.json();
  if (!res.ok) throw new Error(json.error || 'خطأ في الخادم');
  return json;
}

// ─── Counter Animation ────────────────────────────────────────
function animateCounters() {
  document.querySelectorAll('.counter').forEach(el => {
    const target = parseInt(el.dataset.target) || 0;
    let current = 0;
    const step = Math.max(1, Math.ceil(target / 40));
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = current.toLocaleString('ar');
      if (current >= target) clearInterval(timer);
    }, 30);
  });
}

// ─── Charts ───────────────────────────────────────────────────
function initCharts() {
  const daily = STATS.daily || {};
  const labels = Object.keys(daily).map(d => {
    const dt = new Date(d);
    return dt.toLocaleDateString('ar-SA', { month: 'short', day: 'numeric' });
  });
  const values = Object.values(daily);

  const ctx = document.getElementById('chartDaily');
  if (!ctx) return;

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'التذاكر',
        data: values,
        backgroundColor: 'rgba(79, 126, 247, 0.4)',
        borderColor: '#dc2626',
        borderWidth: 2,
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.parsed.y} تذكرة`
          }
        }
      },
      scales: {
        x: { grid: { color: 'rgba(79,126,247,0.05)' }, ticks: { color: '#7a93bb', font: { family: 'Plus Jakarta Sans' } } },
        y: { grid: { color: 'rgba(79,126,247,0.05)' }, ticks: { color: '#7a93bb', font: { family: 'Plus Jakarta Sans' }, stepSize: 1 }, beginAtZero: true }
      }
    }
  });
}

function initLeaderboard() {
  const el = document.getElementById('staffLeaderboard');
  if (!el) return;

  const sorted = [...STAFF].sort((a, b) => (b.tickets_closed || 0) - (a.tickets_closed || 0)).slice(0, 5);

  if (!sorted.length) {
    el.innerHTML = '<div style="color:var(--text-dim);font-size:13px;padding:20px 0;text-align:center">لا يوجد أعضاء دعم بعد</div>';
    return;
  }

  const max = sorted[0]?.tickets_closed || 1;
  el.innerHTML = sorted.map((s, i) => {
    const pct = Math.max(4, Math.round(((s.tickets_closed || 0) / max) * 100));
    const medals = ['🥇','🥈','🥉','4️⃣','5️⃣'];
    return `
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:16px;width:24px;text-align:center">${medals[i]}</span>
        <div style="flex:1;min-width:0">
          <div style="display:flex;justify-content:space-between;margin-bottom:4px">
            <span style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${s.user_id}</span>
            <span style="font-size:11px;color:var(--accent);font-weight:700">${s.tickets_closed || 0}</span>
          </div>
          <div style="height:4px;background:var(--bg4);border-radius:2px;overflow:hidden">
            <div style="height:100%;width:${pct}%;background:var(--accent);border-radius:2px;transition:width 0.8s ease"></div>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

// ─── Ticket Filters ───────────────────────────────────────────
function filterTickets() {
  const search   = document.getElementById('ticket-search')?.value.toLowerCase() || '';
  const status   = document.getElementById('ticket-status-filter')?.value || '';
  const panel    = document.getElementById('ticket-panel-filter')?.value || '';
  const priority = document.getElementById('ticket-priority-filter')?.value || '';

  let visible = 0;
  document.querySelectorAll('.ticket-row').forEach(row => {
    const matchSearch   = !search   || row.dataset.user.includes(search) || row.dataset.id.includes(search);
    const matchStatus   = !status   || row.dataset.status   === status;
    const matchPanel    = !panel    || row.dataset.panel     === panel;
    const matchPriority = !priority || row.dataset.priority  === priority;
    const show = matchSearch && matchStatus && matchPanel && matchPriority;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });

  const countEl = document.getElementById('ticket-count');
  if (countEl) countEl.innerHTML = `إجمالي: <strong>${visible}</strong> تذكرة`;
}

// ─── PANEL PREVIEW ────────────────────────────────────────────
function updatePreview() {
  const title    = document.getElementById('p-embed-title')?.value  || 'فتح تذكرة';
  const desc     = document.getElementById('p-embed-desc')?.value   || '';
  const footer   = document.getElementById('p-embed-footer')?.value || 'SkyTicket • اسم السيرفر';
  const color    = document.getElementById('p-color')?.value       || '#dc2626';
  const btnEmoji = document.getElementById('p-btn-emoji')?.value   || '🎫';
  const btnLabel = document.getElementById('p-btn-label')?.value   || 'فتح تذكرة';
  const preview  = document.getElementById('embed-preview');
  if (!preview) return;
  preview.style.borderColor = color;
  preview.querySelector('.embed-preview-title').textContent = title;
  preview.querySelector('.embed-preview-desc').textContent  = desc;
  const chip = preview.querySelector('#embed-preview-chip');
  if (chip) chip.textContent = `${btnEmoji ? `${btnEmoji} ` : ''}${btnLabel}`.trim();
  const footerEl = preview.querySelector('.embed-preview-footer');
  if (footerEl) footerEl.textContent = footer;
}

function updateEditPreview() {
  const title    = document.getElementById('edit-p-embed-title')?.value || '';
  const desc     = document.getElementById('edit-p-embed-desc')?.value  || '';
  const color    = document.getElementById('edit-p-color')?.value       || '#dc2626';
  const btnEmoji = document.getElementById('edit-p-btn-emoji')?.value   || '🎫';
  const btnLabel = document.getElementById('edit-p-btn-label')?.value   || 'فتح تذكرة';
  const preview  = document.getElementById('edit-embed-preview');
  if (!preview) return;
  preview.style.borderColor = color;
  preview.querySelector('.embed-preview-title').textContent = title;
  preview.querySelector('.embed-preview-desc').textContent  = desc;
  const chip = preview.querySelector('#edit-embed-preview-chip');
  if (chip) chip.textContent = `${btnEmoji ? `${btnEmoji} ` : ''}${btnLabel}`.trim();
}

// ─── PANEL CRUD ───────────────────────────────────────────────
async function createPanel() {
  const name = document.getElementById('p-name')?.value?.trim();
  if (!name) return toast('أدخل اسم اللوحة', 'error');

  try {
    await api('POST', '/api/panel', {
      guild_id:         GUILD_ID,
      name,
      embed_title:      document.getElementById('p-embed-title')?.value   || 'فتح تذكرة',
      embed_description:document.getElementById('p-embed-desc')?.value    || '',
      embed_color:      document.getElementById('p-color')?.value         || '#dc2626',
      embed_footer:     document.getElementById('p-embed-footer')?.value  || '',
      embed_image:      document.getElementById('p-embed-image')?.value   || '',
      embed_thumbnail:  document.getElementById('p-embed-thumbnail')?.value || '',
      welcome_message:  document.getElementById('p-welcome')?.value       || 'مرحباً {user}!',
      close_message:    document.getElementById('p-close-msg')?.value     || 'شكراً لتواصلك!',
      button_emoji:     document.getElementById('p-btn-emoji')?.value     || '🎫',
      button_label:     document.getElementById('p-btn-label')?.value     || 'فتح تذكرة',
      button_style:     document.getElementById('p-btn-style')?.value     || 'DANGER',
      close_button_label: document.getElementById('p-close-label')?.value || 'إغلاق',
      claim_button_label: document.getElementById('p-claim-label')?.value || 'استلام',
      confirm_close_label: document.getElementById('p-confirm-close-label')?.value || 'نعم، أغلق',
      cancel_close_label: document.getElementById('p-cancel-close-label')?.value || 'إلغاء',
      priority_placeholder: document.getElementById('p-priority-placeholder')?.value || 'تغيير الأولوية...',
      rating_placeholder: document.getElementById('p-rating-placeholder')?.value || 'قيّم تجربتك (اختياري)',
      category_open:    document.getElementById('p-cat-open')?.value      || '',
      category_close:   document.getElementById('p-cat-close')?.value     || '',
      mention_role:     document.getElementById('p-mention-role')?.value  || '',
      require_reason:   document.getElementById('p-require-reason')?.checked ? 'true' : 'false',
      dm_on_close:      document.getElementById('p-dm-on-close')?.checked ? 'true' : 'false',
    });
    toast('تم إنشاء اللوحة بنجاح! ✅', 'success');
    closeModal('modal-panel-create');
    setTimeout(() => location.reload(), 800);
  } catch (err) { toast(err.message, 'error'); }
}

async function openPanelEdit(panelId) {
  await loadDropdowns();
  const panel = PANELS.find(p => p.id === panelId);
  if (!panel) return toast('اللوحة غير موجودة', 'error');

  document.getElementById('edit-panel-id').value       = panel.id;
  document.getElementById('edit-p-name').value         = panel.name || '';
  document.getElementById('edit-p-color').value        = panel.embed_color || '#dc2626';
  document.getElementById('edit-p-embed-title').value  = panel.embed_title || '';
  document.getElementById('edit-p-embed-desc').value   = panel.embed_description || '';
  document.getElementById('edit-p-embed-footer').value = panel.embed_footer || '';
  document.getElementById('edit-p-embed-image').value  = panel.embed_image || '';
  document.getElementById('edit-p-embed-thumbnail').value = panel.embed_thumbnail || '';
  document.getElementById('edit-p-welcome').value      = panel.welcome_message || '';
  document.getElementById('edit-p-close-msg').value    = panel.close_message || '';
  document.getElementById('edit-p-btn-emoji').value    = panel.button_emoji || '🎫';
  document.getElementById('edit-p-btn-label').value     = panel.button_label || 'فتح تذكرة';
  document.getElementById('edit-p-btn-style').value     = panel.button_style || 'DANGER';
  document.getElementById('edit-p-close-label').value   = panel.close_button_label || 'إغلاق';
  document.getElementById('edit-p-claim-label').value   = panel.claim_button_label || 'استلام';
  document.getElementById('edit-p-confirm-close-label').value = panel.confirm_close_label || 'نعم، أغلق';
  document.getElementById('edit-p-cancel-close-label').value   = panel.cancel_close_label || 'إلغاء';
  document.getElementById('edit-p-priority-placeholder').value = panel.priority_placeholder || 'تغيير الأولوية...';
  document.getElementById('edit-p-rating-placeholder').value   = panel.rating_placeholder || 'قيّم تجربتك (اختياري)';
  const openCat = panel.category_open || '';
  const closeCat = panel.category_close || '';
  document.getElementById('edit-p-cat-open').value     = openCat;
  document.getElementById('edit-p-cat-close').value    = closeCat;
  if (openCat && !document.getElementById('edit-p-cat-open').querySelector(`option[value="${CSS.escape(openCat)}"]`)) {
    const opt = document.createElement('option');
    opt.value = openCat;
    opt.textContent = `${openCat} (قديم)`;
    document.getElementById('edit-p-cat-open').appendChild(opt);
  }
  if (closeCat && !document.getElementById('edit-p-cat-close').querySelector(`option[value="${CSS.escape(closeCat)}"]`)) {
    const opt = document.createElement('option');
    opt.value = closeCat;
    opt.textContent = `${closeCat} (قديم)`;
    document.getElementById('edit-p-cat-close').appendChild(opt);
  }
  const mentionRole = panel.mention_role || '';
  const mentionSelect = document.getElementById('edit-p-mention-role');
  if (mentionSelect) {
    if (mentionRole && !mentionSelect.querySelector(`option[value="${CSS.escape(mentionRole)}"]`)) {
      const opt = document.createElement('option');
      opt.value = mentionRole;
      opt.textContent = `${mentionRole} (قديم)`;
      mentionSelect.appendChild(opt);
    }
    mentionSelect.value = mentionRole;
  }
  document.getElementById('edit-p-require-reason').checked = !!panel.require_reason;
  document.getElementById('edit-p-dm-on-close').checked    = !!panel.dm_on_close;
  updateEditPreview();
  openModal('modal-panel-edit');
}

async function savePanel() {
  const panelId = document.getElementById('edit-panel-id')?.value;
  if (!panelId) return;
  try {
    await api('PUT', `/api/panel/${panelId}`, {
      name:              document.getElementById('edit-p-name')?.value,
      embed_title:       document.getElementById('edit-p-embed-title')?.value,
      embed_description: document.getElementById('edit-p-embed-desc')?.value,
      embed_color:       document.getElementById('edit-p-color')?.value,
      embed_footer:      document.getElementById('edit-p-embed-footer')?.value,
      embed_image:       document.getElementById('edit-p-embed-image')?.value,
      embed_thumbnail:   document.getElementById('edit-p-embed-thumbnail')?.value,
      welcome_message:   document.getElementById('edit-p-welcome')?.value,
      close_message:     document.getElementById('edit-p-close-msg')?.value,
      button_emoji:      document.getElementById('edit-p-btn-emoji')?.value,
      button_label:      document.getElementById('edit-p-btn-label')?.value,
      button_style:      document.getElementById('edit-p-btn-style')?.value,
      close_button_label:document.getElementById('edit-p-close-label')?.value,
      claim_button_label:document.getElementById('edit-p-claim-label')?.value,
      confirm_close_label:document.getElementById('edit-p-confirm-close-label')?.value,
      cancel_close_label:document.getElementById('edit-p-cancel-close-label')?.value,
      priority_placeholder:document.getElementById('edit-p-priority-placeholder')?.value,
      rating_placeholder:document.getElementById('edit-p-rating-placeholder')?.value,
      category_open:     document.getElementById('edit-p-cat-open')?.value,
      category_close:    document.getElementById('edit-p-cat-close')?.value,
      mention_role:      document.getElementById('edit-p-mention-role')?.value,
      require_reason:    document.getElementById('edit-p-require-reason')?.checked,
      dm_on_close:       document.getElementById('edit-p-dm-on-close')?.checked,
    });
    toast('تم حفظ التغييرات ✅', 'success');
    closeModal('modal-panel-edit');
    setTimeout(() => location.reload(), 800);
  } catch (err) { toast(err.message, 'error'); }
}

async function deletePanel(panelId, name) {
  if (!confirm(`هل أنت متأكد من حذف لوحة "${name}"؟`)) return;
  try {
    await api('DELETE', `/api/panel/${panelId}`);
    document.getElementById(`panel-${panelId}`)?.remove();
    toast(`تم حذف لوحة "${name}" ✅`, 'success');
  } catch (err) { toast(err.message, 'error'); }
}

async function openSendPanel(panelId) {
  await loadDropdowns();
  document.getElementById('send-panel-id').value = panelId;
  document.getElementById('send-channel-id').value = '';
  openModal('modal-send-panel');
}

async function sendPanel() {
  await loadDropdowns();
  const panelId   = document.getElementById('send-panel-id')?.value;
  const channelId = document.getElementById('send-channel-id')?.value?.trim();
  if (!channelId) return toast('اختر القناة', 'error');
  try {
    await api('POST', `/api/panel/${panelId}/send`, { channel_id: channelId });
    toast('تم إرسال اللوحة في القناة ✅', 'success');
    closeModal('modal-send-panel');
  } catch (err) { toast(err.message, 'error'); }
}

// ─── STAFF CRUD ───────────────────────────────────────────────
async function addStaff() {
  await loadDropdowns();
  const userId = document.getElementById('staff-user-id')?.value?.trim();
  if (!userId) return toast('اختر العضو', 'error');
  try {
    await api('POST', '/api/staff', { guild_id: GUILD_ID, user_id: userId });
    toast('تمت إضافة عضو الدعم ✅', 'success');
    closeModal('modal-add-staff');
    setTimeout(() => location.reload(), 800);
  } catch (err) { toast(err.message, 'error'); }
}

async function removeStaff(userId) {
  if (!confirm(`هل أنت متأكد من إزالة ${userId} من فريق الدعم؟`)) return;
  try {
    await api('DELETE', `/api/staff/${userId}/${GUILD_ID}`);
    document.querySelectorAll('.staff-card').forEach(card => {
      if (card.innerHTML.includes(userId)) card.remove();
    });
    toast('تمت إزالة عضو الدعم ✅', 'success');
  } catch (err) { toast(err.message, 'error'); }
}

// ─── KEYWORDS CRUD ────────────────────────────────────────────
async function addKeyword() {
  const keyword  = document.getElementById('kw-keyword')?.value?.trim();
  const response = document.getElementById('kw-response')?.value?.trim();
  if (!keyword || !response) return toast('أدخل الكلمة والرد', 'error');
  try {
    await api('POST', '/api/keyword', {
      guild_id:       GUILD_ID,
      panel_id:       document.getElementById('kw-panel-id')?.value || null,
      keyword,
      response,
      match_type:     document.getElementById('kw-match-type')?.value     || 'contains',
      case_sensitive: document.getElementById('kw-case-sensitive')?.checked ? 'true' : 'false',
    });
    toast('تمت إضافة الرد التلقائي ✅', 'success');
    closeModal('modal-add-keyword');
    setTimeout(() => location.reload(), 800);
  } catch (err) { toast(err.message, 'error'); }
}

async function deleteKeyword(id) {
  if (!confirm('حذف هذا الرد التلقائي؟')) return;
  try {
    await api('DELETE', `/api/keyword/${id}?guild_id=${GUILD_ID}`);
    toast('تم حذف الرد التلقائي ✅', 'success');
    setTimeout(() => location.reload(), 600);
  } catch (err) { toast(err.message, 'error'); }
}

