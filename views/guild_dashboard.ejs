              <% categoryChannels.forEach(ch => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>تصنيف التذاكر المغلقة</label>
            <select id="p-cat-close">
              <option value="">— بدون —</option>
              <% categoryChannels.forEach(ch => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>رتبة الإشعار</label>
          <select id="p-mention-role">
            <option value="">— بدون —</option>
          </select>
          <p style="font-size:11px;color:var(--text-dim);margin-top:4px">اختر الرتبة مباشرة من السيرفر.</p>
        </div>

        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <label style="display:flex;align-items:center;gap:6px;text-transform:none;letter-spacing:0;font-size:13px;font-weight:500;cursor:pointer">
            <input type="checkbox" id="p-require-reason"> يتطلب ذكر سبب عند الفتح
          </label>
          <label style="display:flex;align-items:center;gap:6px;text-transform:none;letter-spacing:0;font-size:13px;font-weight:500;cursor:pointer">
            <input type="checkbox" id="p-dm-on-close" checked> إرسال نسخة النص للمستخدم
          </label>
        </div>

      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="createPanel()">✅ إنشاء اللوحة</button>
      <button class="btn btn-ghost" onclick="closeModal('modal-panel-create')">إلغاء</button>
    </div>
  </div>
</div>


