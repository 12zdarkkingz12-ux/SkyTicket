<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= guild.name %> — SkyTicket</title>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>

<!-- ══════════════════════════════════════════════════════════
     DATA  (server → client)
═══════════════════════════════════════════════════════════ -->
<script>
  const GUILD_ID   = '<%= guild.id %>';
  const GUILD_NAME = '<%- JSON.stringify(guild.name) %>';
  const STATS      = <%- JSON.stringify(stats) %>;
  const PANELS     = <%- JSON.stringify(panels) %>;
  const STAFF      = <%- JSON.stringify(staff) %>;
  const KEYWORDS   = <%- JSON.stringify(keywords) %>;
  const TICKETS    = <%- JSON.stringify(tickets) %>;
  const BANS       = <%- JSON.stringify(bans) %>;
  const LOGS       = <%- JSON.stringify(logs) %>;
  const GUILD_DATA = <%- JSON.stringify(guildData) %>;

  const LOOKUPS = {
    channels: null,
    roles: null,
    members: null,
  };

  async function fetchLookup(kind) {
    if (LOOKUPS[kind]) return LOOKUPS[kind];

    const endpoints = {
      channels: `/api/guild/${GUILD_ID}/channels`,
      roles:    `/api/guild/${GUILD_ID}/roles`,
      members:  `/api/guild/${GUILD_ID}/members`,
    };

    const data = await api('GET', endpoints[kind]);
    LOOKUPS[kind] = Array.isArray(data) ? data : [];
    return LOOKUPS[kind];
  }

  function setSelectOptions(select, items, selectedValue = '', emptyLabel = '— بدون —', formatter = (item) => item.name) {
    if (!select) return;
    const current = selectedValue || select.value || '';
    const previous = Array.from(select.querySelectorAll('option'))
      .find(opt => opt.value === current);

    select.innerHTML = '';

    const empty = document.createElement('option');
    empty.value = '';
    empty.textContent = emptyLabel;
    select.appendChild(empty);

    items.forEach(item => {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = formatter(item);
      select.appendChild(opt);
    });

    if (current && !select.querySelector(`option[value="${CSS.escape(current)}"]`)) {
      const opt = document.createElement('option');
      opt.value = current;
      opt.textContent = `${current} (قديم)`;
      select.appendChild(opt);
    }

    if (current) select.value = current;
    else if (previous) select.value = previous.value;
  }

  async function loadDropdowns() {
    try {
      const [channels, roles, members] = await Promise.all([
        fetchLookup('channels').catch(() => []),
        fetchLookup('roles').catch(() => []),
        fetchLookup('members').catch(() => []),
      ]);

      const channelSelects = [
        document.getElementById('s-log-channel'),
        document.getElementById('send-channel-id'),
      ].filter(Boolean);
      channelSelects.forEach(select => {
        const selected = select.dataset.selected || select.value || '';
        setSelectOptions(select, channels, selected, '— اختر القناة —', ch => `${ch.name} (${ch.id})`);
      });

      const roleSelects = [
        document.getElementById('p-mention-role'),
        document.getElementById('edit-p-mention-role'),
      ].filter(Boolean);
      roleSelects.forEach(select => setSelectOptions(select, roles, select.value, '— بدون —', role => `${role.name}${role.color && role.color !== '#000000' ? ` • ${role.color}` : ''}`));

      const memberSelects = [
        document.getElementById('staff-user-id'),
        document.getElementById('ban-user-id'),
      ].filter(Boolean);
      memberSelects.forEach(select => setSelectOptions(select, members, select.value, '— اختر العضو —', member => `${member.name} (${member.tag || member.id})`));
    } catch (err) {
      console.warn('[UI] Failed to load dropdowns:', err);
    }
  }
</script>

<div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

<div class="layout">

<!-- ══════════════════════════════════════════════════════════
     SIDEBAR
═══════════════════════════════════════════════════════════ -->
<nav class="sidebar" id="guild-sidebar">

  <div class="sidebar-brand">
    <a href="#" class="brand-logo">
      <span class="icon"><img src="/logo.png?v=<%= assetVersion %>" alt="logo" onerror="this.style.display='none'"></span>
      <div>
        <div>SkyTicket</div>
        <div class="brand-ver">Pro v2.0</div>
      </div>
    </a>
  </div>

  <div class="sidebar-guild">
    <div class="guild-card">
      <% if (guild.icon) { %>
        <img src="<%= guild.icon %>" class="guild-icon" alt="icon">
      <% } else { %>
        <div class="guild-icon-placeholder">🏠</div>
      <% } %>
      <div>
        <div class="guild-name"><%= guild.name %></div>
        <div class="guild-badge">● مُتصل</div>
      </div>
    </div>
  </div>

  <ul class="sidebar-nav">
    <li class="nav-section-label">الرئيسية</li>

    <li class="nav-item active" data-tab="overview">
      <span class="nav-icon">📊</span>
      <span>نظرة عامة</span>
    </li>

    <li class="nav-section-label">إدارة التذاكر</li>

    <li class="nav-item" data-tab="panels">
      <span class="nav-icon">🗂️</span>
      <span>اللوحات</span>
      <span class="nav-badge"><%= panels.length %></span>
    </li>

    <li class="nav-item" data-tab="tickets">
      <span class="nav-icon">🎫</span>
      <span>التذاكر</span>
      <span class="nav-badge"><%= stats.openTickets %></span>
    </li>

    <li class="nav-item" data-tab="staff">
      <span class="nav-icon">👥</span>
      <span>فريق الدعم</span>
    </li>

    <li class="nav-item" data-tab="keywords">
      <span class="nav-icon">💬</span>
      <span>الردود التلقائية</span>
    </li>

    <li class="nav-section-label">الإدارة</li>

    <li class="nav-item" data-tab="bans">
      <span class="nav-icon">🚫</span>
      <span>الحظر</span>
      <% if (bans.length) { %>
        <span class="nav-badge" style="background:var(--danger)"><%= bans.length %></span>
      <% } %>
    </li>

    <li class="nav-item" data-tab="settings">
      <span class="nav-icon">⚙️</span>
      <span>الإعدادات</span>
    </li>

    <li class="nav-item" data-tab="logs">
      <span class="nav-icon">📋</span>
      <span>السجلات</span>
    </li>

  </ul>

  <div class="sidebar-user">
    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64"
         class="user-avatar" alt="avatar"
         onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
    <div class="user-info">
      <div class="user-name"><%= user.username %></div>
      <div class="user-role">مدير</div>
    </div>
    <a href="/logout" class="logout-btn" title="تسجيل الخروج">↩</a>
  </div>

</nav>

<!-- ══════════════════════════════════════════════════════════
     MAIN CONTENT
═══════════════════════════════════════════════════════════ -->
<main class="main">
  <button type="button" class="sidebar-toggle btn btn-ghost btn-icon" id="sidebar-toggle" aria-controls="guild-sidebar" aria-expanded="false" aria-label="فتح القائمة">☰</button>

<!-- ──────────────────────────────────────────────────────────
     TAB: OVERVIEW
────────────────────────────────────────────────────────── -->
<div id="tab-overview" class="tab-content active">
  <div class="page-header">
    <div>
      <div class="page-title">نظرة عامة 📊</div>
      <div class="page-subtitle">إحصائيات نظام التذاكر لسيرفر <%= guild.name %></div>
    </div>
    <div class="page-actions">
      <button class="btn btn-ghost btn-sm" onclick="refreshStats()">🔄 تحديث</button>
    </div>
  </div>
  <div class="page-body">

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-icon">🎫</span>
        <div class="stat-value counter" data-target="<%= stats.totalTickets %>">0</div>
        <div class="stat-label">إجمالي التذاكر</div>
      </div>
      <div class="stat-card success">
        <span class="stat-icon">🟢</span>
        <div class="stat-value counter" data-target="<%= stats.openTickets %>">0</div>
        <div class="stat-label">تذاكر مفتوحة</div>
      </div>
      <div class="stat-card warning">
        <span class="stat-icon">✅</span>
        <div class="stat-value counter" data-target="<%= stats.closedToday %>">0</div>
        <div class="stat-label">مغلقة اليوم</div>
      </div>
      <div class="stat-card purple">
        <span class="stat-icon">👥</span>
        <div class="stat-value counter" data-target="<%= stats.totalStaff %>">0</div>
        <div class="stat-label">فريق الدعم</div>
      </div>
      <div class="stat-card danger">
        <span class="stat-icon">⭐</span>
        <div class="stat-value"><%= stats.avgRating || '—' %></div>
        <div class="stat-label">متوسط التقييم</div>
      </div>
    </div>

    <!-- Charts -->
    <div class="charts-row">
      <div class="card">
        <div class="card-header">
          <div class="card-title">📈 التذاكر — آخر 7 أيام</div>
        </div>
        <div class="chart-wrapper">
          <canvas id="chartDaily"></canvas>
        </div>
      </div>
      <div class="card">
        <div class="card-header">
          <div class="card-title">🥇 أفضل فريق الدعم</div>
        </div>
        <div id="staffLeaderboard" style="display:flex;flex-direction:column;gap:8px;"></div>
      </div>
    </div>

    <!-- Recent Tickets -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">🎫 آخر التذاكر</div>
        <button class="btn btn-ghost btn-sm" onclick="showTab('tickets')">عرض الكل ←</button>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>المستخدم</th>
              <th>اللوحة</th>
              <th>الحالة</th>
              <th>الأولوية</th>
              <th>التاريخ</th>
            </tr>
          </thead>
          <tbody>
            <% const recent = tickets.slice(0, 8); %>
            <% if (recent.length === 0) { %>
              <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:32px">لا توجد تذاكر بعد</td></tr>
            <% } else { %>
              <% recent.forEach(t => { %>
              <tr>
                <td><span style="color:var(--accent);font-weight:700">#<%= t.id %></span></td>
                <td><code style="background:var(--bg3);padding:2px 6px;border-radius:4px;font-size:12px"><%= t.userTag %></code></td>
                <td><%= t.panelName %></td>
                <td>
                  <% if(t.status==='open')    { %><span class="badge badge-open">🟢 مفتوحة</span>
                  <% } else if(t.status==='claimed') { %><span class="badge badge-claimed">✋ مستلمة</span>
                  <% } else { %><span class="badge badge-closed">🔒 مغلقة</span><% } %>
                </td>
                <td>
                  <% const pr = {low:'🟢',normal:'🔵',high:'🟡',urgent:'🔴'}; %>
                  <span class="badge badge-<%= t.priority %>"><%= pr[t.priority]||'🔵' %> <%= t.priority %></span>
                </td>
                <td style="color:var(--text-muted);font-size:12px"><%= new Date(t.created_at).toLocaleDateString('ar-SA') %></td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: PANELS
────────────────────────────────────────────────────────── -->
<div id="tab-panels" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">اللوحات 🗂️</div>
      <div class="page-subtitle">إدارة لوحات فتح التذاكر</div>
    </div>
    <div class="page-actions">
      <button class="btn btn-primary" onclick="openModal('modal-panel-create')">
        ＋ إنشاء لوحة
      </button>
    </div>
  </div>
  <div class="page-body">

    <% if (panels.length === 0) { %>
      <div class="empty">
        <div class="empty-icon">🗂️</div>
        <div class="empty-text">لا توجد لوحات بعد</div>
        <div class="empty-sub">أنشئ أول لوحة لبدء استقبال التذاكر</div>
        <button class="btn btn-primary mt-16" onclick="openModal('modal-panel-create')">＋ إنشاء لوحة</button>
      </div>
    <% } else { %>
      <div class="panels-grid" id="panels-grid">
        <% panels.forEach(p => { %>
        <div class="panel-card" id="panel-<%= p.id %>">
          <div class="panel-color-bar" style="background:<%= p.embed_color || '#dc2626' %>"></div>
          <div class="panel-name"><%= p.embed_title || p.name %></div>
          <div class="panel-desc"><%= p.embed_description || p.description || '' %></div>
          <div class="panel-meta">
            <span>🏷️ <%= p.name %></span>
            <% if (p.require_reason) { %><span>📝 يتطلب سبباً</span><% } %>
            <% if (p.dm_on_close) { %><span>📩 DM عند الإغلاق</span><% } %>
            <% if (p.mention_role) { %><span>🔔 ذكر الرتبة</span><% } %>
          </div>
          <div class="panel-actions">
            <button class="btn btn-ghost btn-sm" onclick="openPanelEdit('<%= p.id %>')">✏️ تعديل</button>
            <button class="btn btn-success btn-sm" onclick="openSendPanel('<%= p.id %>')">📤 إرسال</button>
            <button class="btn btn-danger btn-sm" onclick="deletePanel('<%= p.id %>', '<%= p.name %>')">🗑️</button>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: TICKETS
────────────────────────────────────────────────────────── -->
<div id="tab-tickets" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">التذاكر 🎫</div>
      <div class="page-subtitle">عرض وإدارة جميع تذاكر السيرفر</div>
    </div>
  </div>
  <div class="page-body">

    <div class="filter-bar">
      <input type="text" class="search-input" id="ticket-search" placeholder="🔍 ابحث بالمستخدم أو رقم التذكرة..." oninput="filterTickets()">
      <select id="ticket-status-filter" onchange="filterTickets()">
        <option value="">كل الحالات</option>
        <option value="open">🟢 مفتوحة</option>
        <option value="claimed">✋ مستلمة</option>
        <option value="closed">🔒 مغلقة</option>
      </select>
      <select id="ticket-panel-filter" onchange="filterTickets()">
        <option value="">كل اللوحات</option>
        <% panels.forEach(p => { %>
          <option value="<%= p.name %>"><%= p.name %></option>
        <% }) %>
      </select>
      <select id="ticket-priority-filter" onchange="filterTickets()">
        <option value="">كل الأولويات</option>
        <option value="urgent">🔴 عاجلة</option>
        <option value="high">🟡 عالية</option>
        <option value="normal">🔵 عادية</option>
        <option value="low">🟢 منخفضة</option>
      </select>
    </div>

    <div class="card">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>المستخدم</th>
              <th>اللوحة</th>
              <th>فريق الدعم</th>
              <th>الحالة</th>
              <th>الأولوية</th>
              <th>التقييم</th>
              <th>التاريخ</th>
              <th>إجراء</th>
            </tr>
          </thead>
          <tbody id="tickets-tbody">
            <% if (tickets.length === 0) { %>
              <tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:40px">📭 لا توجد تذاكر</td></tr>
            <% } else { %>
              <% tickets.forEach(t => { %>
              <tr class="ticket-row"
                  data-user="<%= t.userTag.toLowerCase() %>"
                  data-id="<%= t.id %>"
                  data-status="<%= t.status %>"
                  data-panel="<%= t.panelName %>"
                  data-priority="<%= t.priority %>">
                <td><span style="color:var(--accent);font-weight:700">#<%= t.id %></span></td>
                <td>
                  <code style="background:var(--bg3);padding:2px 6px;border-radius:4px;font-size:12px">
                    <%= t.userTag %>
                  </code>
                </td>
                <td style="font-size:13px"><%= t.panelName %></td>
                <td style="font-size:12px;color:var(--text-muted)">
                  <%= t.staffTag || '—' %>
                </td>
                <td>
                  <% if(t.status==='open') { %><span class="badge badge-open">🟢 مفتوحة</span>
                  <% } else if(t.status==='claimed') { %><span class="badge badge-claimed">✋ مستلمة</span>
                  <% } else { %><span class="badge badge-closed">🔒 مغلقة</span><% } %>
                </td>
                <td>
                  <% const pr={low:'🟢 منخفضة',normal:'🔵 عادية',high:'🟡 عالية',urgent:'🔴 عاجلة'}; %>
                  <span class="badge badge-<%= t.priority %>"><%= pr[t.priority]||t.priority %></span>
                </td>
                <td>
                  <% if (t.rating) { %>
                    <span style="color:var(--warning)">
                      <%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5
                    </span>
                  <% } else { %>
                    <span style="color:var(--text-dim)">—</span>
                  <% } %>
                </td>
                <td style="color:var(--text-muted);font-size:12px;white-space:nowrap">
                  <%= new Date(t.created_at).toLocaleDateString('ar-SA') %>
                </td>
                <td>
                  <% if (t.status === 'closed') { %>
                    <button class="btn btn-ghost btn-sm" onclick="viewTranscript(<%= t.id %>)">📄 النص</button>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
      <div id="ticket-count" style="padding:12px 14px;font-size:12px;color:var(--text-muted);border-top:1px solid var(--border2)">
        إجمالي: <strong><%= tickets.length %></strong> تذكرة
      </div>
    </div>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: STAFF
────────────────────────────────────────────────────────── -->
<div id="tab-staff" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">فريق الدعم 👥</div>
      <div class="page-subtitle">إدارة أعضاء فريق الدعم وإحصائياتهم</div>
    </div>
    <div class="page-actions">
      <button class="btn btn-primary" onclick="openModal('modal-add-staff')">＋ إضافة عضو</button>
    </div>
  </div>
  <div class="page-body">

    <% if (staff.length === 0) { %>
      <div class="empty">
        <div class="empty-icon">👥</div>
        <div class="empty-text">لا يوجد أعضاء دعم بعد</div>
        <div class="empty-sub">أضف أعضاء فريق الدعم لبدء العمل</div>
        <button class="btn btn-primary mt-16" onclick="openModal('modal-add-staff')">＋ إضافة عضو</button>
      </div>
    <% } else { %>
      <div class="staff-grid">
        <% staff.forEach(s => { %>
        <div class="staff-card">
          <div class="staff-avatar">👤</div>
          <div class="staff-info">
            <div class="staff-tag">
              <span class="available-dot <%= s.available ? '' : 'offline' %>"></span>
              <code style="font-size:13px"><%= s.user_id %></code>
            </div>
            <div class="staff-stats">
              <span>🎫 <%= s.tickets_closed %> مغلقة</span>
              <span>⭐ <%= s.avg_rating || '—' %></span>
              <span><%= s.available ? '🟢 متاح' : '🔴 غير متاح' %></span>
            </div>
          </div>
          <button class="btn btn-danger btn-sm btn-icon"
                  onclick="removeStaff('<%= s.user_id %>')"
                  title="إزالة من الدعم">🗑️</button>
        </div>
        <% }) %>
      </div>

      <!-- Staff leaderboard table -->
      <div class="card mt-24">
        <div class="card-header">
          <div class="card-title">🏆 لوحة المتصدرين</div>
        </div>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>الترتيب</th>
                <th>العضو</th>
                <th>التذاكر المغلقة</th>
                <th>متوسط التقييم</th>
                <th>إجمالي التقييمات</th>
                <th>الحالة</th>
              </tr>
            </thead>
            <tbody>
              <% const sorted = [...staff].sort((a,b) => (b.tickets_closed||0)-(a.tickets_closed||0)); %>
              <% sorted.forEach((s, i) => { %>
              <tr>
                <td>
                  <% if(i===0) { %><span style="font-size:18px">🥇</span>
                  <% } else if(i===1) { %><span style="font-size:18px">🥈</span>
                  <% } else if(i===2) { %><span style="font-size:18px">🥉</span>
                  <% } else { %><span style="color:var(--text-dim)">#<%= i+1 %></span><% } %>
                </td>
                <td><code style="background:var(--bg3);padding:2px 8px;border-radius:4px;font-size:12px"><%= s.user_id %></code></td>
                <td><strong style="color:var(--accent)"><%= s.tickets_closed || 0 %></strong></td>
                <td>
                  <% if (s.avg_rating) { %>
                    <span style="color:var(--warning)">⭐ <%= s.avg_rating %></span>
                  <% } else { %>—<% } %>
                </td>
                <td style="color:var(--text-muted)"><%= s.total_ratings || 0 %></td>
                <td>
                  <% if (s.available) { %><span class="badge badge-open">🟢 متاح</span>
                  <% } else { %><span class="badge badge-closed">🔴 غير متاح</span><% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: KEYWORDS
────────────────────────────────────────────────────────── -->
<div id="tab-keywords" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">الردود التلقائية 💬</div>
      <div class="page-subtitle">الردود التلقائية على الكلمات داخل التذاكر</div>
    </div>
    <div class="page-actions">
      <button class="btn btn-primary" onclick="openModal('modal-add-keyword')">＋ إضافة رد</button>
    </div>
  </div>
  <div class="page-body">

    <% if (keywords.length === 0) { %>
      <div class="empty">
        <div class="empty-icon">💬</div>
        <div class="empty-text">لا توجد ردود تلقائية</div>
        <div class="empty-sub">أضف كلمات مفتاحية للرد التلقائي داخل التذاكر</div>
        <button class="btn btn-primary mt-16" onclick="openModal('modal-add-keyword')">＋ إضافة رد</button>
      </div>
    <% } else { %>
      <div class="card">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>الكلمة المفتاحية</th>
                <th>نوع المطابقة</th>
                <th>اللوحة</th>
                <th>مرات الاستخدام</th>
                <th>الرد</th>
                <th>إجراء</th>
              </tr>
            </thead>
            <tbody>
              <% keywords.forEach(kw => { %>
              <tr>
                <td>
                  <code style="background:var(--accent-bg);color:var(--accent);padding:3px 8px;border-radius:4px;font-size:13px">
                    <%= kw.keyword %>
                  </code>
                </td>
                <td>
                  <% const mt={exact:'تطابق كامل',contains:'يحتوي على',starts_with:'يبدأ بـ'}; %>
                  <span class="badge badge-claimed"><%= mt[kw.match_type] || kw.match_type %></span>
                </td>
                <td style="font-size:12px;color:var(--text-muted)">
                  <% const kp = panels.find(p=>p.id===kw.panel_id); %>
                  <%= kp ? kp.name : '🌐 الكل' %>
                </td>
                <td style="color:var(--text-muted)"><%= kw.hit_count || 0 %> مرة</td>
                <td style="max-width:200px;font-size:13px" class="truncate" title="<%= kw.response %>">
                  <%= kw.response %>
                </td>
                <td>
                  <button class="btn btn-danger btn-sm"
                          onclick="deleteKeyword('<%= kw.id %>')">🗑️ حذف</button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: BANS
────────────────────────────────────────────────────────── -->
<div id="tab-bans" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">الحظر 🚫</div>
      <div class="page-subtitle">إدارة المستخدمين المحظورين من فتح التذاكر</div>
    </div>
    <div class="page-actions">
      <button class="btn btn-danger" onclick="openModal('modal-add-ban')">＋ حظر مستخدم</button>
    </div>
  </div>
  <div class="page-body">

    <% if (bans.length === 0) { %>
      <div class="empty">
        <div class="empty-icon">🚫</div>
        <div class="empty-text">لا يوجد حظر نشط</div>
        <div class="empty-sub">المستخدمون المحظورون سيظهرون هنا</div>
      </div>
    <% } else { %>
      <div class="card">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>المستخدم</th>
                <th>السبب</th>
                <th>تاريخ الحظر</th>
                <th>ينتهي في</th>
                <th>بواسطة</th>
                <th>إجراء</th>
              </tr>
            </thead>
            <tbody id="bans-tbody">
              <% bans.forEach(b => { %>
              <tr id="ban-<%= b.user_id %>">
                <td><code style="background:var(--bg3);padding:2px 8px;border-radius:4px;font-size:12px"><%= b.user_id %></code></td>
                <td style="max-width:200px;font-size:13px"><%= b.reason || '—' %></td>
                <td style="font-size:12px;color:var(--text-muted)">
                  <%= new Date(b.created_at).toLocaleDateString('ar-SA') %>
                </td>
                <td>
                  <% if (b.expires_at) { %>
                    <span style="color:var(--warning);font-size:12px">
                      <%= new Date(b.expires_at).toLocaleDateString('ar-SA') %>
                    </span>
                  <% } else { %>
                    <span class="badge badge-closed">دائم</span>
                  <% } %>
                </td>
                <td style="font-size:12px;color:var(--text-muted)"><code><%= b.banned_by %></code></td>
                <td>
                  <button class="btn btn-success btn-sm" onclick="unbanUser('<%= b.user_id %>')">
                    ✅ رفع الحظر
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: SETTINGS
────────────────────────────────────────────────────────── -->
<div id="tab-settings" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">الإعدادات ⚙️</div>
      <div class="page-subtitle">إعدادات نظام التذاكر للسيرفر</div>
    </div>
  </div>
  <div class="page-body">

    <div style="max-width:700px">

      <!-- General Settings -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">⚙️ إعدادات عامة</div>
        </div>
        <div class="form-grid">

          <div class="form-grid form-grid-2">
            <div class="form-group">
              <label>أقصى تذاكر مفتوحة للمستخدم</label>
              <input type="number" id="s-max-tickets" min="1" max="10"
                     value="<%= guildData.max_tickets_per_user || 1 %>">
            </div>
            <div class="form-group">
              <label>بادئة اسم التذكرة</label>
              <input type="text" id="s-ticket-prefix"
                     value="<%= guildData.ticket_prefix || 'ticket' %>"
                     placeholder="ticket">
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="form-group">
              <label>ساعات الإغلاق التلقائي</label>
              <input type="number" id="s-auto-close" min="1"
                     value="<%= guildData.auto_close_hours || 72 %>">
            </div>
            <div class="form-group">
              <label>ساعات التحذير قبل الإغلاق</label>
              <input type="number" id="s-warn-hours" min="1"
                     value="<%= guildData.auto_close_warn_hours || 48 %>">
            </div>
          </div>

          <div class="form-group">
            <label>قناة السجلات</label>
            <select id="s-log-channel" data-selected="<%= guildData.log_channel_id || '' %>">
              <option value="">— اختر القناة —</option>
            </select>
            <p style="font-size:11px;color:var(--text-dim);margin-top:4px">تظهر القنوات النصية المتاحة في السيرفر.</p>
          </div>

        </div>
      </div>

      <div class="mt-16"></div>

      <!-- Toggle Settings -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">🔘 خيارات إضافية</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">

          <div class="toggle-group">
            <div>
              <div class="toggle-label">📩 إرسال نسخة النص للمستخدم عند الإغلاق</div>
              <div class="toggle-desc">يُرسل للمستخدم رسالة خاصة مع محتوى التذكرة</div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="s-dm-transcript" <%= (guildData.dm_transcript) ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="toggle-group">
            <div>
              <div class="toggle-label">🔔 ذكر الرتبة عند فتح التذكرة</div>
              <div class="toggle-desc">يُذكر دور فريق الدعم عند إنشاء تذكرة جديدة</div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="s-ping-on-open" <%= (guildData.ping_on_open !== false) ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="toggle-group">
            <div>
              <div class="toggle-label">📝 طلب سبب إغلاق التذكرة</div>
              <div class="toggle-desc">يُطلب من فريق الدعم ذكر سبب الإغلاق</div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="s-require-close" <%= (guildData.require_close_reason) ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

        </div>
      </div>

      <div class="mt-16"></div>
      <button class="btn btn-primary" onclick="saveSettings()">💾 حفظ الإعدادات</button>

    </div>
  </div>
</div>

<!-- ──────────────────────────────────────────────────────────
     TAB: LOGS
────────────────────────────────────────────────────────── -->
<div id="tab-logs" class="tab-content">
  <div class="page-header">
    <div>
      <div class="page-title">السجلات 📋</div>
      <div class="page-subtitle">سجل أحداث نظام التذاكر</div>
    </div>
  </div>
  <div class="page-body">

    <% if (logs.length === 0) { %>
      <div class="empty">
        <div class="empty-icon">📋</div>
        <div class="empty-text">لا توجد سجلات بعد</div>
      </div>
    <% } else { %>
      <div class="card">
        <div class="log-feed">
          <% const logIcons = {
            TICKET_OPEN:  {icon:'🎫', label:'فتح تذكرة',      color:'var(--success)'},
            TICKET_CLOSE: {icon:'🔒', label:'إغلاق تذكرة',     color:'var(--text-muted)'},
            TICKET_CLAIM: {icon:'✋', label:'استلام تذكرة',    color:'var(--accent)'},
            AUTO_CLOSE:   {icon:'⏱️', label:'إغلاق تلقائي',   color:'var(--warning)'},
            PANEL_CREATE: {icon:'🗂️', label:'إنشاء لوحة',      color:'var(--accent)'},
            PANEL_EDIT:   {icon:'✏️', label:'تعديل لوحة',      color:'var(--accent)'},
            PANEL_DELETE: {icon:'🗑️', label:'حذف لوحة',        color:'var(--danger)'},
            STAFF_ADD:    {icon:'👤', label:'إضافة دعم',        color:'var(--success)'},
            STAFF_REMOVE: {icon:'👤', label:'إزالة دعم',        color:'var(--danger)'},
            BAN:          {icon:'🚫', label:'حظر مستخدم',       color:'var(--danger)'},
            UNBAN:        {icon:'✅', label:'رفع حظر',           color:'var(--success)'},
            SETTINGS_UPDATE:{icon:'⚙️',label:'تحديث الإعدادات', color:'var(--purple)'}
          }; %>

          <% logs.forEach(log => { %>
            <% const meta = logIcons[log.action] || {icon:'📌', label:log.action, color:'var(--text-muted)'}; %>
            <div class="log-item">
              <div class="log-icon" style="color:<%= meta.color %>"><%= meta.icon %></div>
              <div class="log-body">
                <div class="log-action" style="color:<%= meta.color %>"><%= meta.label %></div>
                <div class="log-details">
                  <% if (log.actor_id) { %><code style="font-size:11px"><%= log.actor_id %></code><% } %>
                  <% if (log.target_id) { %> → <code style="font-size:11px"><%= log.target_id %></code><% } %>
                </div>
              </div>
              <div class="log-time"><%= new Date(log.created_at).toLocaleString('ar-SA') %></div>
            </div>
          <% }) %>

        </div>
      </div>
    <% } %>

  </div>
</div>

</main><!-- end .main -->
</div><!-- end .layout -->

