<!-- ══════════════════════════════════════════════════════════
     MODAL: CREATE PANEL
═══════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-panel-create">
  <div class="modal" style="max-width:760px">
    <div class="modal-header">
      <div class="modal-title">🗂️ إنشاء لوحة جديدة</div>
      <button class="modal-close" onclick="closeModal('modal-panel-create')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>اسم اللوحة (داخلي)</label>
            <input type="text" id="p-name" placeholder="مثال: دعم فني">
          </div>
          <div class="form-group">
            <label>لون الـ Embed</label>
            <input type="color" id="p-color" value="#dc2626" oninput="updatePreview()">
          </div>
        </div>

        <div class="form-group">
          <label>عنوان الـ Embed</label>
          <input type="text" id="p-embed-title" placeholder="فتح تذكرة" oninput="updatePreview()">
        </div>

        <div class="form-group">
          <label>وصف الـ Embed</label>
          <textarea id="p-embed-desc" rows="3" placeholder="اضغط على الزر أدناه لفتح تذكرة..." oninput="updatePreview()"></textarea>
        </div>

        <div class="form-group">
          <label>ذيل الـ Embed (اختياري)</label>
          <input type="text" id="p-embed-footer" placeholder="SkyTicket • اسم السيرفر" oninput="updatePreview()">
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>صورة الـ Embed</label>
            <input type="url" id="p-embed-image" placeholder="https://...">
          </div>
          <div class="form-group">
            <label>صورة المصغّر</label>
            <input type="url" id="p-embed-thumbnail" placeholder="https://...">
          </div>
        </div>

        <div>
          <label>معاينة مباشرة</label>
          <div class="embed-preview" id="embed-preview">
            <div class="embed-preview-title">فتح تذكرة</div>
            <div class="embed-preview-desc">اضغط على الزر أدناه لفتح تذكرة...</div>
            <div class="embed-preview-chip" id="embed-preview-chip">🎫 فتح تذكرة</div>
            <div class="embed-preview-footer">SkyTicket • اسم السيرفر</div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>رسالة الترحيب</label>
            <textarea id="p-welcome" rows="2" placeholder="مرحباً {user}! سيتم مساعدتك قريباً.">مرحباً {user}! سيتم مساعدتك قريباً.</textarea>
          </div>
          <div class="form-group">
            <label>رسالة الإغلاق</label>
            <textarea id="p-close-msg" rows="2" placeholder="تم إغلاق التذكرة. شكراً لتواصلك!">تم إغلاق التذكرة. شكراً لتواصلك!</textarea>
          </div>
        </div>

        <div class="form-grid form-grid-3">
          <div class="form-group">
            <label>إيموجي زر التذكرة</label>
            <input type="text" id="p-btn-emoji" maxlength="4" placeholder="🎫" value="🎫" oninput="updatePreview()">
          </div>
          <div class="form-group">
            <label>اسم زر التذكرة</label>
            <input type="text" id="p-btn-label" placeholder="فتح تذكرة" value="فتح تذكرة" oninput="updatePreview()">
          </div>
          <div class="form-group">
            <label>لون الزر</label>
            <select id="p-btn-style">
              <option value="DANGER">🔴 أحمر (Danger)</option>
              <option value="PRIMARY">🔵 أزرق (Primary)</option>
              <option value="SUCCESS">🟢 أخضر (Success)</option>
              <option value="SECONDARY">⚫ رمادي (Secondary)</option>
            </select>
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>اسم زر الإغلاق</label>
            <input type="text" id="p-close-label" value="إغلاق">
          </div>
          <div class="form-group">
            <label>اسم زر الاستلام</label>
            <input type="text" id="p-claim-label" value="استلام">
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>تأكيد الإغلاق</label>
            <input type="text" id="p-confirm-close-label" value="نعم، أغلق">
          </div>
          <div class="form-group">
            <label>إلغاء الإغلاق</label>
            <input type="text" id="p-cancel-close-label" value="إلغاء">
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>نص قائمة الأولوية</label>
            <input type="text" id="p-priority-placeholder" value="تغيير الأولوية...">
          </div>
          <div class="form-group">
            <label>نص التقييم</label>
            <input type="text" id="p-rating-placeholder" value="قيّم تجربتك (اختياري)">
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>تصنيف التذاكر المفتوحة</label>
